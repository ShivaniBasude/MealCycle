<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌱 MealCycle"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#245C3A"/>

        <!-- Welcome -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello, Receiver! 👋"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#245C3A"
            android:layout_marginTop="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find surplus food available in your area."
            android:textSize="15sp"
            android:textColor="#526456"
            android:layout_marginTop="8dp"/>

        <!-- Browse Food Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#E3F1E4"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥗"
                android:textSize="40sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find Available Food"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#245C3A"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discover surplus food shared by nearby donors."
                android:textSize="14sp"
                android:textColor="#526456"
                android:layout_marginTop="6dp"/>

            <Button
                android:id="@+id/btnBrowseFood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Browse Food"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#287A49"
                android:layout_marginTop="18dp"/>

        </LinearLayout>

        <!-- My Requests -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Requests"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#245C3A"
            android:layout_marginTop="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track the food you have requested."
            android:textSize="14sp"
            android:textColor="#526456"
            android:layout_marginTop="5dp"/>

        <Button
            android:id="@+id/btnMyRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View My Requests"
            android:textAllCaps="false"
            android:textColor="#287A49"
            android:backgroundTint="#DCEBDD"
            android:layout_marginTop="14dp"/>

        <!-- History -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Collection History"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#245C3A"
            android:layout_marginTop="25dp"/>

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View History"
            android:textAllCaps="false"
            android:textColor="#287A49"
            android:backgroundTint="#DCEBDD"
            android:layout_marginTop="10dp"/>

        <!-- Profile -->
        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#287A49"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>
