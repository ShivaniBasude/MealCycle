<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥗 Browse Food"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:letterSpacing="-0.01" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Claim fresh surplus food donated in your community."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Items"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_chip_filter_selected"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cooked Meals"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_chip_filter"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bakery"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_chip_filter"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Produce &amp; Fruits"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_chip_filter"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Food Card 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vegetable Biryani Rice"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Donor: Green Park Cafe"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_available"
                    android:text="Available"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/badge_available_text"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- Tags Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_secondary"
                    android:text="🍱 10 portions"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_secondary"
                    android:text="📍 1.2 km away"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_secondary"
                    android:text="⏰ Till 8:00 PM"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_dark"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Freshly cooked, packed in sealed food containers with cutlery."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestRice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Request This Food"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"
                android:layout_marginTop="14dp"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

        </LinearLayout>

        <!-- Food Card 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fresh Artisan Bread &amp; Buns"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Donor: Sunrise Bakery"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_available"
                    android:text="Available"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/badge_available_text"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_secondary"
                    android:text="🍞 20 pieces"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_secondary"
                    android:text="📍 2.4 km away"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_secondary"
                    android:text="⏰ Till 9:30 PM"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_dark"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Assorted whole wheat bread loaves and dinner buns baked today."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestBread"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Request This Food"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"
                android:layout_marginTop="14dp"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

        </LinearLayout>

        <!-- Food Card 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fresh Organic Fruits"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Donor: Green Valley Mart"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_available"
                    android:text="Available"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/badge_available_text"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_secondary"
                    android:text="🍎 5 kg crate"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_secondary"
                    android:text="📍 0.8 km away"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_secondary"
                    android:text="⏰ Till 10:00 PM"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_dark"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apples, oranges, and bananas in good edible condition."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestFruit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Request This Food"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"
                android:layout_marginTop="14dp"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
