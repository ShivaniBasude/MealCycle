<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍱 Add Food Listing"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:letterSpacing="-0.01" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="List your extra portions so nearby receivers can claim them quickly."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Card 1: Food Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food Details"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="14dp" />

            <!-- Food Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food Name *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etFoodName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. Vegetable Biryani, Bread rolls"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textSize="15sp" />

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etCategory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. Cooked meal, Bakery, Produce"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textSize="15sp" />

            <!-- Quantity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quantity &amp; Portions *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. 10 portions, 5 kg"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Card 2: Pickup Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup Information"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="14dp" />

            <!-- Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup Address / Landmark *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. Green Park Sector 4, Community Hall"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textSize="15sp" />

            <!-- Deadline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Until (Pickup Deadline) *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPickupDeadline"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. Today by 8:00 PM"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Card 3: Additional Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description &amp; Notes (Optional)"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="Dietary details (Veg/Non-veg), storage instructions, packaging notes..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="14dp"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Publish Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishFood"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Publish Food Listing"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:layout_marginBottom="20dp"
            app:cornerRadius="14dp"
            app:elevation="1dp" />

    </LinearLayout>

</ScrollView>
