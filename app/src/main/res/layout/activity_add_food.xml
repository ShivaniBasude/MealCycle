<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Food Listing"
            android:textColor="#245C3A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="Share your surplus food with people who need it."
            android:textColor="#526456"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food name *"
            android:textColor="#245C3A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFoodName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: Vegetable rice"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Food category *"
            android:textColor="#245C3A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: Cooked meal, fruits, bakery"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Quantity *"
            android:textColor="#245C3A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: 10"
            android:inputType="numberDecimal"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pickup location *"
            android:textColor="#245C3A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter locality or pickup address"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Food description"
            android:textColor="#245C3A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mention ingredients or other useful details"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pickup deadline *"
            android:textColor="#245C3A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPickupDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: 14 Nov, 6:00 PM"
            android:inputType="text"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnPublishFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#287A49"
            android:text="Publish Food Listing"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
