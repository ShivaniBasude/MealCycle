<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to MealCycle!"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#245C3A"
            android:layout_marginTop="55dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How would you like to use MealCycle?"
            android:textSize="16sp"
            android:textColor="#526456"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="35dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍱"
            android:textSize="55sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I want to Donate Food"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#245C3A"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share surplus food with people and organizations who need it."
            android:textSize="14sp"
            android:textColor="#526456"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnDonor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue as Donor"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#287A49"
            android:layout_marginTop="18dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D5DFD3"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤝"
            android:textSize="55sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I want to Receive Food"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#245C3A"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find available surplus food from nearby donors."
            android:textSize="14sp"
            android:textColor="#526456"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnReceiver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue as Receiver"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#287A49"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>

</ScrollView>
